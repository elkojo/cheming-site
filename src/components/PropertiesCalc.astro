---
// Native Properties tool (Phase 7): physical properties of 469 pure components.
// The Zoho sheet searched its 1977 table by part of a name and showed the constants plus four properties at a
// reference temperature. Here: one search box (name, formula or CAS number), every value with its source
// (best evaluated source per value, owner's decision 2026-11-21), unit selectors per row, range warnings, and the
// Harlacher vapour pressure of the 1977 table. Rendered with the Zoho default (Methane, −170 °C) filled in.
import DrawingFrame from './DrawingFrame.astro';
import { byName, COMPOUNDS } from '../lib/calc/properties';
import { CONST_ROWS, TEMP_ROWS, UNIT_LISTS, constOut, tempOut, atT, formulaHtml } from '../lib/calc/properties-view';
import { toSI } from '../lib/calc/units';
import { mathHtml } from '../lib/calc/types';

const C0 = 'Methane', T0 = -170, TU0 = '°C';
const c = byName(C0)!;
const T = toSI(UNIT_LISTS.T.find((u) => u.label === TU0)!, T0);
const at = atT(c, T);
const id = (k: string) => `prp-${k}`;
const opts = (kind: string, sel: string) => UNIT_LISTS[kind].map((u) => ({ label: u.label, selected: u.label === sel }));
---
<DrawingFrame>
  <div class="calc prop" data-prop data-count={COMPOUNDS.length}>
    <div class="bar">
      <p>Constants and temperature-dependent properties of {COMPOUNDS.length} pure components. Each value names its source.</p>
      <button type="button" class="reset" data-reset>Clear all inputs</button>
    </div>

    <section class="grp" aria-labelledby={id('c-title')}>
      <h2 id={id('c-title')}>Component</h2>
      <div class="pick">
        <label for={id('q')} class="lb">Search by name, formula or CAS number</label>
        <div class="combo">
          <input id={id('q')} data-q value={C0} type="text" autocomplete="off" spellcheck="false"
            role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls={id('list')} />
          <ul id={id('list')} class="list" role="listbox" aria-label="Matching components" hidden></ul>
        </div>
        <p class="count" data-count-out aria-live="polite"></p>
      </div>
      <p class="ident" data-ident>
        <b>{c.n}</b>{c.f && <> · <span set:html={formulaHtml(c.f)} /></>}{c.cas && <> · CAS {c.cas}</>}{c.aka && <span class="aka"> · on the original sheet: {c.aka}</span>}
      </p>
    </section>

    <section class="grp" aria-labelledby={id('k-title')}>
      <h2 id={id('k-title')}>Constants</h2>
      <table class="props" data-table="const">
        <thead><tr><th scope="col">Property</th><th scope="col">Value</th><th scope="col">Unit</th><th scope="col">Source</th></tr></thead>
        <tbody>
          {CONST_ROWS.map((r) => {
            const o = constOut(c, r, r.def);
            return (
              <tr data-row={r.key}>
                <th scope="row"><span class="lb" set:html={r.label.replace(/T_b/, mathHtml('T_b'))} /> <span class="eq" set:html={mathHtml(r.sym)} /></th>
                <td class="o"><output>{o.v}</output></td>
                <td class="u">{UNIT_LISTS[r.kind].length > 1
                  ? <select data-u aria-label={`${r.label} unit`}>{opts(r.kind, r.def).map((x) => <option selected={x.selected}>{x.label}</option>)}</select>
                  : <span>{r.def}</span>}</td>
                <td class="s"><span data-src title={o.src?.title}>{o.src?.label ?? o.note ?? ''}</span></td>
              </tr>
            );
          })}
        </tbody>
      </table>
      <p class="note" set:html={`Heats of formation and Gibbs energy: ideal gas at 25 °C and 1 bar, from the elements in their standard states. Per-mass units divide by the molar mass. cal and kcal are International Table calories (4.1868 J). “—” = no reliable value found. Hover over a source for the full reference; all are listed under <a href="#src-properties">Sources</a>.`} />
    </section>

    <section class="grp" aria-labelledby={id('t-title')}>
      <h2 id={id('t-title')}>At a temperature</h2>
      <table class="io">
        <tbody>
          <tr>
            <th scope="row"><label for={id('t')}><span class="lb">Reference temperature</span> <span class="eq" set:html={mathHtml('T')} /></label></th>
            <td class="v"><input id={id('t')} data-t value={T0} type="text" inputmode="decimal" autocomplete="off" spellcheck="false" /></td>
            <td class="u"><select data-tu aria-label="Temperature unit">{opts('T', TU0).map((x) => <option selected={x.selected}>{x.label}</option>)}</select></td>
          </tr>
        </tbody>
      </table>
      <table class="props" data-table="temp">
        <thead><tr><th scope="col">Property</th><th scope="col">Value</th><th scope="col">Unit</th><th scope="col">Source</th></tr></thead>
        <tbody>
          {TEMP_ROWS.map((r) => {
            const o = tempOut(c, at[r.key], r, r.def, TU0);
            return (
              <>
                <tr data-row={r.key}>
                  <th scope="row"><span class="lb">{r.label}</span> <span class="eq" set:html={mathHtml(r.sym)} /></th>
                  <td class="o"><output class={o.warn ? 'warn' : undefined}>{o.v}</output></td>
                  <td class="u"><select data-u aria-label={`${r.label} unit`}>{opts(r.kind, r.def).map((x) => <option selected={x.selected}>{x.label}</option>)}</select></td>
                  <td class="s"><span data-src title={o.src?.title}>{o.src?.label ?? ''}</span></td>
                </tr>
                <tr class="sub" data-sub={r.key}><td colspan="4"><span data-note class={o.warn ? 'warn' : undefined} set:html={o.note ?? ''} /></td></tr>
              </>
            );
          })}
        </tbody>
      </table>
      <p class="note">
        Vapour pressure: Wagner or Antoine equation (Poling 2001, Landolt-Börnstein), else the 1977 Antoine equation; the Harlacher
        equation is the 1977 table's second one. Liquid properties at saturation. An orange value is outside the range the equation was fitted to.
      </p>
    </section>
    <p class="sr" aria-live="polite" data-status></p>
  </div>
</DrawingFrame>

<script>
  import { search, byName, type Compound } from '../lib/calc/properties';
  import { CONST_ROWS, TEMP_ROWS, UNIT_LISTS, constOut, tempOut, atT, formulaHtml, type Out } from '../lib/calc/properties-view';
  import { toSI } from '../lib/calc/units';
  import { parseNumber } from '../lib/calc/types';

  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

  for (const root of document.querySelectorAll<HTMLElement>('[data-prop]')) {
    const $ = <T extends Element>(s: string, el: ParentNode = root) => el.querySelector<T>(s)!;
    const q = $<HTMLInputElement>('[data-q]'), list = $<HTMLUListElement>('.list');
    const tIn = $<HTMLInputElement>('[data-t]'), tu = $<HTMLSelectElement>('[data-tu]');
    const status = (t: string) => { $('[data-status]').textContent = t; };
    let current: Compound | undefined = byName(q.value.trim());
    let matches: Compound[] = [];
    let active = -1;

    const put = (tr: HTMLElement, o: Out) => {
      const out = tr.querySelector('output')!;
      out.textContent = o.v;
      out.classList.toggle('warn', !!o.warn);
      const s = tr.querySelector<HTMLElement>('[data-src]')!;
      s.textContent = o.src?.label ?? o.note ?? '';
      if (o.src) s.title = o.src.title; else s.removeAttribute('title');
    };

    const render = () => {
      const c = current;
      const id = $('[data-ident]');
      id.innerHTML = c
        ? `<b>${esc(c.n)}</b>${c.f ? ` · <span>${formulaHtml(esc(c.f))}</span>` : ''}${c.cas ? ` · CAS ${c.cas}` : ''}${c.aka ? `<span class="aka"> · on the original sheet: ${esc(c.aka)}</span>` : ''}`
        : q.value.trim() ? 'No component chosen: pick one from the list.' : '';
      for (const r of CONST_ROWS) {
        const tr = $<HTMLElement>(`[data-table="const"] tr[data-row="${r.key}"]`);
        put(tr, constOut(c, r, tr.querySelector('select')?.value ?? r.def));
      }
      const tv = tIn.value.trim() === '' ? NaN : parseNumber(tIn.value);
      const T = Number.isFinite(tv) ? toSI(UNIT_LISTS.T.find((u) => u.label === tu.value)!, tv) : NaN;
      const tBad = tIn.value.trim() !== '' && (!Number.isFinite(tv) || T <= 0);
      tIn.toggleAttribute('aria-invalid', tBad);
      const at = c && Number.isFinite(T) && T > 0 ? atT(c, T) : undefined;
      for (const r of TEMP_ROWS) {
        const tr = $<HTMLElement>(`[data-table="temp"] tr[data-row="${r.key}"]`);
        const o = !c ? { v: '' } : at ? tempOut(c, at[r.key], r, tr.querySelector('select')!.value, tu.value) : { v: tBad ? '—' : '' };
        put(tr, o);
        const note = $<HTMLElement>(`[data-sub="${r.key}"] [data-note]`);
        note.innerHTML = o.note ?? '';
        note.classList.toggle('warn', !!o.warn);
      }
    };

    // ── combobox ──
    const close = () => { list.hidden = true; q.setAttribute('aria-expanded', 'false'); q.removeAttribute('aria-activedescendant'); active = -1; };
    const show = () => {
      matches = search(q.value, 50);
      $('[data-count-out]').textContent = q.value.trim() ? `${matches.length === 50 ? '50+' : matches.length} match${matches.length === 1 ? '' : 'es'}` : '';
      list.innerHTML = matches.map((c, i) =>
        `<li id="prp-o${i}" role="option" data-i="${i}" aria-selected="false"><span class="nm">${esc(c.n)}</span><span class="fm">${formulaHtml(esc(c.f ?? ''))}${c.cas ? ` · ${c.cas}` : ''}</span></li>`).join('');
      list.hidden = matches.length === 0;
      q.setAttribute('aria-expanded', String(!list.hidden));
      active = -1;
    };
    const highlight = (i: number) => {
      const items = list.querySelectorAll<HTMLElement>('[role=option]');
      items.forEach((el, k) => el.setAttribute('aria-selected', String(k === i)));
      active = i;
      if (items[i]) { q.setAttribute('aria-activedescendant', items[i].id); items[i].scrollIntoView({ block: 'nearest' }); }
    };
    const choose = (c: Compound) => {
      current = c; q.value = c.n; close(); render();
      status(`${c.n} selected.`);
    };

    q.addEventListener('input', () => {
      show();
      const exact = byName(q.value.trim()) ?? matches.find((m) => m.n.toLowerCase() === q.value.trim().toLowerCase());
      current = exact;
      render();
    });
    q.addEventListener('focus', () => { if (!current) show(); });
    q.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); if (list.hidden) show(); highlight(Math.min(active + 1, matches.length - 1)); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); highlight(Math.max(active - 1, 0)); }
      else if (e.key === 'Enter') { if (!list.hidden && matches.length) { e.preventDefault(); choose(matches[active >= 0 ? active : 0]); } }
      else if (e.key === 'Escape') close();
    });
    list.addEventListener('mousedown', (e) => e.preventDefault());   // keep focus in the input
    list.addEventListener('click', (e) => {
      const li = (e.target as HTMLElement).closest<HTMLElement>('[role=option]');
      if (li) choose(matches[Number(li.dataset.i)]);
    });
    q.addEventListener('blur', () => setTimeout(close, 100));

    root.addEventListener('input', (e) => { if (e.target === tIn) render(); });
    root.addEventListener('change', (e) => { if ((e.target as HTMLElement).matches('select')) render(); });
    $('[data-reset]').addEventListener('click', () => {
      q.value = ''; tIn.value = ''; current = undefined; close();
      $('[data-count-out]').textContent = '';
      render(); q.focus();
      status('All input fields cleared.');
    });

    render();
  }
</script>

<style>
  .calc { background: #fff; border: 1px solid var(--ink); padding: 1rem 1.25rem 1.5rem; }
  .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--rule); }
  .bar p { margin: 0; color: var(--muted); font-size: 0.9375rem; }
  .reset {
    height: 2.25rem; padding-inline: 0.875rem; border: 1px solid var(--line); background: none; color: var(--line);
    font: 600 0.875rem/1 var(--font-ui); cursor: pointer; transition: background-color 150ms ease-out, color 150ms ease-out;
  }
  .reset:hover { background: var(--line); color: var(--paper); }

  .grp { padding-block: 1.25rem; border-bottom: 1px solid var(--rule); }
  .grp:last-of-type { border-bottom: 0; }
  h2 { margin: 0 0 0.5rem; font-size: 1.0625rem; font-weight: 650; }
  .calc :global(sub) { font-size: 0.75em; font-style: normal; line-height: 0; }

  .pick { display: grid; grid-template-columns: auto minmax(0, 22rem) auto; align-items: center; gap: 0.25rem 0.75rem; }
  .combo { position: relative; }
  .count { margin: 0; color: var(--muted); font-size: 0.8125rem; }
  .list {
    position: absolute; z-index: 5; left: 0; right: 0; top: calc(100% + 2px); max-height: 18rem; overflow-y: auto;
    margin: 0; padding: 0; list-style: none; background: #fff; border: 1px solid var(--ink); box-shadow: 0 6px 16px rgb(0 0 0 / 0.12);
  }
  .list :global(li) { display: flex; justify-content: space-between; gap: 0.75rem; padding: 0.375rem 0.5rem; cursor: pointer; font-size: 0.9375rem; }
  .list :global(li[aria-selected='true']), .list :global(li:hover) { background: var(--zoho-in); }
  .list :global(.fm) { color: var(--muted); font-size: 0.8125rem; white-space: nowrap; }
  .ident { margin: 0.625rem 0 0; font-size: 0.9375rem; min-height: 1.4em; }
  .ident :global(b) { font-weight: 650; }
  .ident :global(.aka) { color: var(--muted); }

  table { border-collapse: collapse; width: 100%; font-size: 0.9375rem; }
  th, td { padding: 0.125rem 0; text-align: left; vertical-align: middle; }
  thead th { padding-top: 0.25rem; color: var(--muted); font-size: 0.8125rem; font-weight: 600; }
  tbody th { font-weight: 400; padding-right: 0.75rem; line-height: 1.35; }
  th label { cursor: text; }
  .lb { margin-right: 0.625rem; }
  .calc :global(.eq) { display: inline-block; white-space: nowrap; }
  .calc :global(.eq i), .note :global(i), .sub :global(i) { font-style: italic; padding-right: 0.05em; }
  .io { max-width: 36rem; margin-bottom: 0.5rem; }
  .io .v { width: 8.5rem; }
  .io .u { width: 7.5rem; padding-left: 0.375rem; }
  .props .o { width: 8.5rem; }
  .props .u { width: 8rem; padding-left: 0.375rem; color: var(--muted); white-space: nowrap; }
  .props .s { width: 9.5rem; padding-left: 0.625rem; color: var(--muted); font-size: 0.8125rem; line-height: 1.2; }
  .props .s span[title] { cursor: help; border-bottom: 1px dotted var(--rule); }
  .sub td { padding: 0 0 0.375rem; color: var(--muted); font-size: 0.75rem; line-height: 1.35; }
  .sub td:empty, .sub span:empty { display: none; }
  .sub .warn { color: var(--markup); }

  input, output, select { display: block; width: 100%; height: 1.875rem; border-radius: 0; color: var(--ink); font: inherit; }
  input, output { padding: 0 0.5rem; border: 1px solid transparent; font-variant-numeric: tabular-nums; line-height: 1.75rem; }
  input { background: var(--zoho-in); border-color: var(--muted); }
  input:focus { outline: 2px solid var(--line); outline-offset: 1px; border-color: var(--line); }
  input[aria-invalid] { border-color: var(--markup); box-shadow: inset 0 0 0 1px var(--markup); }
  output { background: var(--zoho-out); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  output.warn { box-shadow: inset 0 0 0 2px var(--markup); }
  select { padding: 0 0.25rem; border: 1px solid var(--rule); background: #fff; font-size: 0.875rem; cursor: pointer; }
  select:focus { outline: 2px solid var(--line); outline-offset: 1px; }
  .note { margin: 0.5rem 0 0; color: var(--muted); font-size: 0.8125rem; max-width: 52rem; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* Phone: name on top, then value | unit, source below */
  @media (max-width: 48rem) {
    .calc { border-inline: 0; padding-inline: var(--gutter); }
    .calc :global(.eq) { white-space: normal; }
    .pick { grid-template-columns: minmax(0, 1fr) auto; }
    .pick > label { grid-column: 1 / -1; }
    .list :global(li) { flex-direction: column; gap: 0; }
    .io .v { width: 6.75rem; }
    .io .u { width: 6.25rem; }
    .props thead { display: none; }
    .props tbody tr[data-row] { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0.25rem; padding-top: 0.5rem; border-top: 1px solid var(--rule); }
    .props tbody tr[data-row] th { grid-column: 1 / -1; padding: 0; }
    .props td.o, .props td.u { width: auto; padding: 0; }
    .props td.s { grid-column: 1 / -1; width: auto; padding: 0 0 0.25rem; }
    .props tr.sub { display: block; }
    .props tr.sub td { display: block; }
  }
</style>
