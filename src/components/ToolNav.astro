---
// "Tools" drop-down menu grouped by category. Works without JavaScript (<details>).
import { categories, tools } from '../data/tools';
import { url } from '../lib/url';
---
<details class="toolnav">
  <summary>Tools</summary>
  <div class="panel">
    {categories.map((c) => (
      <section>
        <h2>{c.title}</h2>
        <ul>
          {tools.filter((t) => t.category === c.id).map((t) => (
            <li><a href={url(`${t.slug}/`)}>{t.title}</a></li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</details>

<style>
  .toolnav { position: relative; }
  summary { cursor: pointer; }
  .panel { position: absolute; right: 0; z-index: 10; background: #fff; border: 1px solid var(--line);
           padding: 1rem; display: grid; grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
           gap: 1rem; width: min(52rem, calc(100vw - 2rem)); max-height: 80vh; overflow: auto; }
  h2 { font-size: .8rem; text-transform: uppercase; letter-spacing: .05em; margin: 0 0 .25rem; color: var(--muted); }
  ul { list-style: none; margin: 0; padding: 0; }
</style>
