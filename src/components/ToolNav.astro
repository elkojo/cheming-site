---
// "Tools" menu in the header: a native popover listing every tool by category.
import { categories, tools } from '../data/tools';
import { url } from '../lib/url';
import Bubble from './Bubble.astro';

interface Props { current?: string }
const { current } = Astro.props;
---
<button class="navlink" type="button" popovertarget="toolmenu" aria-haspopup="true">
  Tools
  <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M2 4.5 6 8.5l4-4" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
</button>

<div id="toolmenu" popover class="menu">
  <div class="cols">
    {categories.map((c) => (
      <section>
        <h2>{c.title}</h2>
        <ul>
          {tools.filter((t) => t.category === c.id).map((t) => (
            <li>
              <a href={url(`${t.slug}/`)} aria-current={t.slug === current ? 'page' : undefined}>
                <Bubble tag={t.tag} sub={t.sub} size="sm" />
                <span>{t.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</div>

<style>
  .menu {
    position: fixed;
    inset: var(--header-h) 0 auto auto;
    margin: 0 1rem 0 auto;
    width: min(60rem, calc(100vw - 2rem));
    max-height: calc(100dvh - var(--header-h) - 1rem);
    overflow: auto;
    padding: 1.25rem 1.5rem 1.5rem;
    border: 1.5px solid var(--ink);
    border-top: 0;
    background: var(--paper);
    color: var(--ink);
  }
  .menu:popover-open { animation: drop 160ms cubic-bezier(0.16, 1, 0.3, 1); }
  @keyframes drop { from { opacity: 0; transform: translateY(-6px); } }
  @media (prefers-reduced-motion: reduce) { .menu:popover-open { animation: none; } }

  .cols { display: grid; grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr)); gap: 1.25rem 2rem; }
  h2 {
    margin: 0 0 0.5rem;
    padding-bottom: 0.375rem;
    border-bottom: 1px solid var(--rule);
    font: 400 0.8125rem/1 var(--font-drawing);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  ul { list-style: none; margin: 0; padding: 0; }
  a {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.25rem 0.375rem;
    margin-inline: -0.375rem;
    color: var(--ink);
    text-decoration: none;
    font-size: 0.9375rem;
  }
  a:hover { background: var(--wash); }
  a[aria-current='page'] { background: var(--wash); font-weight: 600; }
  a[aria-current='page'] :global(.bubble) { color: var(--line); }

  @media (max-width: 40rem) {
    .menu { margin: 0; width: 100vw; border-inline: 0; padding-inline: 1rem; }
  }
</style>
