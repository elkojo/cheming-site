---
// How the calculators work. Yellow and green match the cells inside the Zoho sheets;
// native calculators (Phase 7) use the same colours.
interface Props { compact?: boolean; native?: boolean }
const { compact = false, native = false } = Astro.props;
---
<dl class:list={['legend', { compact }]} aria-label="How to use the sheets">
  <div><dt><span class="sw in" aria-hidden="true"></span>Yellow cells</dt><dd>input: type your values</dd></div>
  <div><dt><span class="sw out" aria-hidden="true"></span>Green cells</dt><dd>calculated output</dd></div>
  {native ? (
    <>
      <div><dt>Results</dt><dd>update as you type</dd></div>
      <div><dt>Reset</dt><dd>button above the fields</dd></div>
    </>
  ) : (
    <>
      <div><dt>Units</dt><dd>double-click to change</dd></div>
      <div><dt>Reset</dt><dd>reload the page; nothing is saved</dd></div>
    </>
  )}
</dl>

<style>
  .legend { display: flex; flex-wrap: wrap; gap: 0.5rem 1.75rem; margin: 0; font-size: 0.9375rem; }
  .legend div { display: flex; align-items: center; gap: 0.375rem; }
  dt { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600; }
  dd { margin: 0; color: var(--muted); }
  .sw { width: 1.75rem; height: 1rem; border: 1px solid var(--ink); }
  .in { background: var(--zoho-in); }
  .out { background: var(--zoho-out); }
  .compact { font-size: 0.8125rem; gap: 0.25rem 1.25rem; }
  .compact .sw { width: 1.25rem; height: 0.75rem; }
</style>
