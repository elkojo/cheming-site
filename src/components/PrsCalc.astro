    $('[data-csv]').addEventListener('click', (e) => {
      e.preventDefault();
      if (!last) return;
      const rowsT = [...root.querySelectorAll('[data-thead] th')].map((x) => x.textContent!.replace(/\s+/g, ' ').trim());
      const body = [...root.querySelectorAll('[data-tbody] tr')].map((tr) => [...tr.querySelectorAll('td')].map((td) => td.textContent));
      const csv = [rowsT, ...body].map((r) => r.join(',')).join('\r\n');
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob(['﻿' + csv], { type: 'text/csv;charset=utf-8' }));
      a.download = 'pressurizing-depressurizing.csv'; a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    });
    segInit(root, 'mode', (x) => {
      st.mode = x as Case['mode'];
      // a consistent example for each direction when the fields still hold the other one's example
      const p = (k: string) => inp(k).value.trim();
      if (st.mode === 'press' && p('P0') === '800' && p('Pend') === '15' && p('Pext') === '0') { inp('P0').value = '0'; inp('Pend').value = '700'; inp('Pext').value = '800'; }
      if (st.mode === 'depress' && p('P0') === '0' && p('Pend') === '700' && p('Pext') === '800') { inp('P0').value = '800'; inp('Pend').value = '15'; inp('Pext').value = '0'; }
