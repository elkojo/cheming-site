    for (const b of root.querySelectorAll<HTMLButtonElement>('[data-use]')) b.addEventListener('click', () => {
      const P = b.dataset.use === 'P50' ? last?.P50 ?? (() => { const d = read('Pdes', (x) => x > PATM); return Number.isFinite(d) ? api521Target(d).half : undefined; })()
        : (() => { const d = read('Pdes', (x) => x > PATM); return Number.isFinite(d) ? api521Target(d).fire : undefined; })();
