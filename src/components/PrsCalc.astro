        if (dep && !(Pend > Pext)) warn('2', 'The end pressure must be above the back pressure (the flow stops at the back pressure; the time would be infinite).');
        if (!dep && !(P0 < Pend)) warn('2', 'Pressurizing: the end pressure must be above the start pressure.');
        if (!dep && !(Pend < Pext)) warn('2', 'The end pressure must be below the supply pressure.');
      }
      // API 521 targets
      let P50: number | undefined, Pfire: number | undefined;
      const Pdes = dep ? read('Pdes', (x) => x > PATM) : NaN;
      if (dep && Number.isFinite(Pdes)) { const a = api521Target(Pdes); P50 = a.half; Pfire = a.fire; }
      show('P50', P50, 'p'); show('Pfire', Pfire, 'p');
      vis('api', dep && P50 !== undefined);

      // device
      let dev: Device | undefined;
      const sizing = st.calc === 'size';
      const tsz = sizing ? read('tsz', (x) => x > 0) * 60 : NaN;
      show('cvReq', undefined); show('dReq', undefined); show('betaReq', undefined); show('pickSize', undefined);
      const caseOk = [V, M, Z, k, T0, Ts, P0, Pend, Pext].every(Number.isFinite);
      if (st.dev === 'valve') {
        const cv = read('cv', (x) => x > 0), xt = read('xt', (x) => x > 0 && x < 1.2);
        if (sizing) {
          if (caseOk && Number.isFinite(xt) && tsz > 0) {
            const req = cvForTime(c, xt, tsz);
            show('cvReq', req);
            if (Number.isFinite(req)) dev = { kind: 'valve', cv: req, xt };
            const s = style();
            if (s) {
              const fit = s.sizes.find((z) => { const r = run(c, { kind: 'valve', cv: z.cv, xt: z.xt }, 400); return r.ok && r.t <= tsz * (1 + 1e-9); });
              show('pickSize', fit ? `${fit.size}″ (Cv ${fit.cv}, xT ${fit.xt}): ${fmt(fromSI(unit('time'), run(c, { kind: 'valve', cv: fit.cv, xt: fit.xt }).t))} ${shortUnit(units.time)}` : 'none of the listed sizes is large enough: several valves in parallel');
            }
          }
        } else if (Number.isFinite(cv) && Number.isFinite(xt)) dev = { kind: 'valve', cv, xt };
        $('[data-dev-note]').innerHTML = 'Fully open valve, IEC 60534 gas equation; Fisher representative <i>C</i><sub>v</sub> and <i>x</i><sub>T</sub> at rated travel (choose a size or type the vendor\'s values).';
      } else {
        const D = read('D', (x) => x > 0), mu = read('mu', (x) => x > 0);
        c.gas.mu = mu;
        if (sizing) {
          if (caseOk && D > 0 && mu > 0 && tsz > 0) {
            const b = boreForTime(c, D, tsz);
            show('dReq', b.d, 'len'); show('betaReq', b.d / D);
            if (!b.reachable) warn('3', 'Even the largest useful bore (β near its maximum) does not reach the target time: use several orifices, a larger pipe or a valve.');
            dev = { kind: 'orifice', d: b.d, D };
          }
        } else {
          const d = read('d', (x) => x > 0);
          if (d > 0 && D > 0 && mu > 0) { dev = { kind: 'orifice', d, D }; if (d / D > 0.75 || d / D < 0.1) warn('3', `β = ${fmt(d / D)}: outside ISO 5167-2 limits (0.10–0.75); the result is an estimate.`); }
        }
        $('[data-dev-note]').innerHTML = 'Square-edged orifice with flange taps, as the RO tool: ISO 5167-2 below the critical pressure ratio, critical flow with <i>C</i><sub>d</sub> 0.75–0.84 above it.';
      }

      // transient
      const r = caseOk && dev ? run(c, dev) : undefined;
      if (r && !r.ok && r.why && !warns['2']) warn('4', r.why);
      last = r?.ok ? { r, c, P50, Pfire } : undefined;
      const std = STD_T[st.std];
      const stdLab = { '0C': '0 °C', '15C': '15 °C', '20C': '20 °C', '60F': '60 °F' }[st.std];
      $('[data-res-cap]').innerHTML = !last ? '' : `${sizing ? (st.dev === 'valve' ? 'For the required valve coefficient.' : 'For the required orifice bore.') : 'For the device in step 3.'} Standard volume flows at ${stdLab} and 1.01325 bar.`;
      show('t', last?.r.t, 'time'); show('dm', last?.r.dm, 'mass');
      show('W0', last?.r.W0, 'mflow'); show('Wend', last?.r.Wend, 'mflow');
      show('Q0', last ? stdFlow(last.r.W0, M, std) : undefined, 'qstd'); show('Qend', last ? stdFlow(last.r.Wend, M, std) : undefined, 'qstd');
      show('Tend', last ? last.r.Tend : undefined, 'temp');
      const t50 = last && P50 !== undefined ? timeAt(last.r, P50) : NaN, tf = last && Pfire !== undefined ? timeAt(last.r, Pfire) : NaN;
      show('t50', last && P50 !== undefined ? (Number.isFinite(t50) ? t50 : 'not reached (end pressure higher)') : undefined, Number.isFinite(t50) ? 'time' : undefined);
      show('tfire', last && Pfire !== undefined ? (Number.isFinite(tf) ? tf : 'not reached (end pressure higher)') : undefined, Number.isFinite(tf) ? 'time' : undefined);
      const tgt = read('ttgt', (x) => x > 0) * 60;
      const verdict = $('[data-api-verdict]');
      if (last && P50 !== undefined && tgt > 0) {
        const ok = (t: number) => (Number.isFinite(t) ? (t <= tgt ? '✓ within' : '✗ beyond') : '–');
        verdict.innerHTML = `Target ${fmt(tgt / 60)} min: 50 % of design ${ok(t50)}, fire target ${ok(tf)}.`;
        if (P0 <= P50) warn('2', 'The start pressure is already at or below 50 % of the design pressure.');
      } else verdict.textContent = '';
      if (last && st.thermo === 'adiabatic' && dep) warn('4', `Adiabatic blowdown: the gas cools to ${fmt(fromSI(unit('temp'), last.r.Tmin))} ${shortUnit(units.temp)}. Check the minimum design metal temperature and hydrate or liquid formation; the real gas (and the metal) stays warmer because of heat from the walls.`);
      if (last && st.thermo === 'adiabatic' && !dep) warn('4', `Adiabatic filling: the gas heats up to ${fmt(fromSI(unit('temp'), last.r.Tmax))} ${shortUnit(units.temp)} (at most k·T<sub>s</sub>).`);
      // table
      const tb = $('[data-tbody]'), th = $('[data-thead]');
      th.innerHTML = `<tr><th scope="col">t <span class="hu">${shortUnit(units.time)}</span></th><th scope="col">P <span class="hu">${shortUnit(units.p)}</span></th><th scope="col">T <span class="hu">${shortUnit(units.temp)}</span></th><th scope="col">W <span class="hu">${shortUnit(units.mflow)}</span></th><th scope="col">Q<sub>std</sub> <span class="hu">${shortUnit(units.qstd)}</span></th><th scope="col">${dep ? 'Vented' : 'Added'} <span class="hu">${shortUnit(units.mass)}</span></th></tr>`;
      tb.innerHTML = last ? sample(last.r, 20).map((p) => `<tr>${[fromSI(unit('time'), p.t), fromSI(unit('p'), p.P), fromSI(unit('temp'), p.T), fromSI(unit('mflow'), p.W), fromSI(unit('qstd'), stdFlow(p.W, M, std)), fromSI(unit('mass'), p.moved)].map((v) => `<td class="num">${fmt(v)}</td>`).join('')}</tr>`).join('') : '';
