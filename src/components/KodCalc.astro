  .kod :global(.wall) { fill: none; stroke: var(--ink); stroke-width: 1.6; stroke-linejoin: round; }
  .kod :global(.liq) { fill: color-mix(in srgb, var(--line) 24%, #fff); }
  .kod :global(.lvl) { stroke: var(--line); stroke-width: 1; stroke-dasharray: 6 3; }
  .kod :global(.lab) { font: 600 11px var(--font-ui); fill: var(--line); }
  .kod :global(.flow) { stroke: var(--ink); stroke-width: 1.4; }
