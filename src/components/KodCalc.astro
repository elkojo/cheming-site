  .warn :global(li) { padding: 0.5rem 0.75rem; margin-top: 0.375rem; border-left: 3px solid var(--markup); background: var(--wash); font-size: 0.875rem; }
  .tbtn { margin-top: 0.5rem; height: 2rem; padding-inline: 0.75rem; border: 1px solid var(--line); background: none; color: var(--line); font: 600 0.8125rem/1 var(--font-ui); cursor: pointer; }
  .tbtn:hover:not(:disabled) { background: var(--line); color: var(--paper); }
