---
// The Zoho sheet, set inside the drawing frame.
import DrawingFrame from './DrawingFrame.astro';
interface Props { src: string; title: string }
const { src, title } = Astro.props;
---
<DrawingFrame>
  <iframe src={src} title={`${title} calculator (Zoho Sheet)`} loading="eager"></iframe>
</DrawingFrame>

<style>
  iframe {
    display: block;
    width: 100%;
    height: max(36rem, calc(100dvh - var(--header-h) - 2 * 1.125rem - 1.5rem));
    border: 1px solid var(--ink);
    background: #fff;
  }
  @media (max-width: 40rem) {
    iframe { border-inline: 0; height: max(30rem, calc(100dvh - var(--header-h))); }
  }
</style>
