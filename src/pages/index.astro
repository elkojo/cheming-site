---
import Base from '../layouts/Base.astro';
import Bubble from '../components/Bubble.astro';
import { categories, tools } from '../data/tools';

// Index layout (owner, 2026-11-26): as compact as possible, General always first (top left). The script below measures
// the categories and packs them into the number of columns and the arrangement with the smallest height; without
// script the categories flow in a plain grid in category order.
import { url } from '../lib/url';
---
<Base>
  <div class="sheet">
    <section class="intro" aria-labelledby="intro-h">
      <h1 id="intro-h">Engineering calculation tools for oil &amp; gas and petrochemical processes</h1>
      <p>Every tool shows its equations and references.</p>
    </section>

    <div class="finder" role="search">
      <label for="q">Find a tool</label>
      <input id="q" type="search" placeholder="Tag or name: PSV, pump, steam…" autocomplete="off" spellcheck="false" />
      <output id="count" for="q" aria-live="polite">{tools.length} tools</output>
    </div>

    <div class="index" id="index">
      {categories.map((c) => (
        <section class="cat" aria-labelledby={`cat-${c.id}`} data-cat={c.id}>
          <h2 id={`cat-${c.id}`}>{c.title}</h2>
          <ul>
            {tools.filter((t) => t.category === c.id).map((t) => (
              <li data-search={[t.tag, t.sub, t.title, t.name, t.standard, t.slug].filter(Boolean).join(' ').toLowerCase()}>
                <a href={url(`${t.slug}/`)}>
                  <Bubble tag={t.tag} sub={t.sub} native={!!t.native} />
                  <span class="txt">
                    <span class="name">{t.title}</span>
                    <span class="desc">{t.description ?? t.name}</span>
                  </span>
                </a>
                {t.credit && <p class="credit">Credits: <a href={t.credit.url} rel="noopener">{t.credit.name}</a></p>}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <p class="empty" id="empty" hidden>
      No tool matches “<span id="empty-q"></span>”. Try a tag such as PSV, CV or KOD, or
      <a href={url('about/#contact')}>ask for the tool you need</a>.
    </p>

    <p class="request">Missing a calculation? Feature requests are welcome: <a href={url('about/#contact')}>get in touch</a>.</p>
  </div>
</Base>

<script>
  const q = document.getElementById('q') as HTMLInputElement;
  const rows = [...document.querySelectorAll<HTMLLIElement>('#index li')];
  const index = document.getElementById('index')!;
  const cats = [...index.querySelectorAll<HTMLElement>('.cat')];   // in category order; cats[0] = General
  const count = document.getElementById('count')!;
  const empty = document.getElementById('empty')!;
  const emptyQ = document.getElementById('empty-q')!;

  function apply() {
    const terms = q.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const li of rows) {
      const hit = terms.every((t) => li.dataset.search!.includes(t));
      li.hidden = !hit;
      if (hit) shown++;
    }
    for (const c of cats) c.hidden = !c.querySelector('li:not([hidden])');
    layout();
    count.textContent = shown === rows.length ? `${rows.length} tools` : `${shown} of ${rows.length}`;
    empty.hidden = shown > 0;
    emptyQ.textContent = q.value.trim();
  }
  // ── compact layout: try 1–4 columns and every assignment of the categories to them; keep the smallest height ──
  const MIN_COL = 17.5, GAP_X = 2.5, GAP_Y = 2;   // rem
  let lastKey = '';
  function layout() {
    const rem = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
    const W = index.clientWidth, gx = GAP_X * rem, gy = GAP_Y * rem;
    const vis = cats.filter((c) => !c.hidden);
    const kMax = Math.max(1, Math.min(4, vis.length, Math.floor((W + gx) / (MIN_COL * rem + gx))));
    // measure every category at each candidate column width
    const probe = document.createElement('div');
    probe.style.cssText = 'position:absolute;visibility:hidden;left:0;top:0';
    document.body.append(probe);
    let best: { h: number; cols: HTMLElement[][]; k: number; spread: number } | undefined;
    for (let k = 1; k <= kMax; k++) {
      const colW = (W - gx * (k - 1)) / k;
      probe.style.width = `${colW}px`;
      const h = new Map(vis.map((c) => { const cl = c.cloneNode(true) as HTMLElement; probe.append(cl); const v = cl.offsetHeight; cl.remove(); return [c, v]; }));
      // General (vis[0] when shown) is fixed in column 0; the others take every assignment
      const rest = vis[0] === cats[0] ? vis.slice(1) : vis;
      const n = rest.length;
      for (let code = 0; code < k ** n; code++) {
        const cols: HTMLElement[][] = Array.from({ length: k }, () => []);
        if (vis[0] === cats[0]) cols[0].push(cats[0]);
        let x = code;
        for (const c of rest) { cols[x % k].push(c); x = Math.floor(x / k); }
        if (cols.some((col) => !col.length)) continue;
        const heights = cols.map((col) => col.reduce((s, c) => s + h.get(c)!, 0) + gy * (col.length - 1));
        const H = Math.max(...heights), spread = H - Math.min(...heights);
        if (!best || H < best.h - 1 || (Math.abs(H - best.h) <= 1 && spread < best.spread)) best = { h: H, cols, k, spread };
      }
    }
    probe.remove();
    if (!best) return;
    // columns in the order of their first category; categories in category order inside a column
    const ord = (c: HTMLElement) => cats.indexOf(c);
    for (const col of best.cols) col.sort((a, b) => ord(a) - ord(b));
    best.cols.sort((a, b) => ord(a[0]) - ord(b[0]));
    const key = best.cols.map((col) => col.map(ord).join(',')).join('|');
    if (key === lastKey) return;
    lastKey = key;
    index.classList.add('packed');
    index.style.setProperty('--k', String(best.k));
    for (const old of index.querySelectorAll('.col')) old.replaceWith(...old.children);
    for (const col of best.cols) { const d = document.createElement('div'); d.className = 'col'; d.append(...col); index.append(d); }
    for (const c of cats.filter((x) => x.hidden)) index.append(c);
  }
  let rt = 0, lastW = 0;
  new ResizeObserver(() => { cancelAnimationFrame(rt); rt = requestAnimationFrame(() => { if (index.clientWidth !== lastW) { lastW = index.clientWidth; lastKey = ''; layout(); } }); }).observe(index);

  q.addEventListener('input', apply);
  q.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      const first = rows.find((li) => !li.hidden)?.querySelector('a');
      if (first) first.click();
    }
    if (e.key === 'Escape') { q.value = ''; apply(); }
  });
  apply();
</script>

<style>
  .sheet { max-width: 84rem; margin: 0 auto; padding: 2.5rem var(--gutter) 0; }

  h1 { margin: 0; max-width: 40ch; font-size: 1.75rem; line-height: 1.2; font-weight: 650; letter-spacing: -0.015em; }
  .intro > p { margin: 0.5rem 0 1.25rem; color: var(--muted); max-width: 65ch; }

  .finder {
    display: grid;
    grid-template-columns: auto min(28rem, 60vw) auto;
    align-items: center;
    justify-content: start;
    gap: 0.75rem 1rem;
    margin: 2.25rem 0 1.5rem;
    padding: 0.875rem 0;
    border-block: 1.5px solid var(--ink);
  }
  .finder label { font: 400 0.8125rem/1 var(--font-drawing); letter-spacing: 0.08em; text-transform: uppercase; }
  input[type='search'] {
    width: 100%;
    height: 2.5rem;
    padding: 0 0.75rem;
    border: 1px solid var(--muted);
    border-radius: 0;
    background: #fff;
    color: var(--ink);
    font: inherit;
  }
  input[type='search']::placeholder { color: #6b7585; }
  input[type='search']:focus-visible { outline-offset: 0; border-color: var(--line); }
  output { color: var(--muted); font-size: 0.875rem; }

  .index {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 2rem 2.5rem;
    align-items: start;
  }
  /* packed by the script: --k equal columns, each a stack of categories */
  .index.packed { grid-template-columns: repeat(var(--k), minmax(0, 1fr)); }
  .index :global(.col) { display: grid; gap: 2rem; align-content: start; }
  .cat[hidden] { display: none; }
  .cat h2 {
    margin: 0 0 0.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--ink);
    font: 400 0.9375rem/1 var(--font-drawing);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  ul { list-style: none; margin: 0; padding: 0; }
  li + li { border-top: 1px solid var(--rule); }
  li a {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.5rem 0.5rem;
    margin-inline: -0.5rem;
    color: var(--ink);
    text-decoration: none;
    transition: background-color 150ms ease-out;
  }
  li a:hover { background: var(--wash); }
  li a:hover :global(.bubble) { color: var(--line); }
  .txt { display: grid; min-width: 0; }
  .name { font-weight: 600; }
  .desc { font-size: 0.875rem; color: var(--muted); line-height: 1.35; }
  .credit { margin: -0.25rem 0 0.5rem calc(2.75rem + 0.875rem); font-size: 0.8125rem; color: var(--muted); }
  .credit a { display: inline; padding: 0; margin: 0; color: var(--line); text-decoration: underline; }

  .empty { margin: 1rem 0 0; padding: 1rem; border: 1px dashed var(--muted); max-width: 52rem; }
  .request { margin: 3rem 0 0; color: var(--muted); }

  @media (max-width: 40rem) {
    .sheet { padding-top: 1.5rem; }
    h1 { font-size: 1.375rem; }
    .finder { grid-template-columns: 1fr auto; }
    .finder label { grid-column: 1 / -1; }
  }
</style>
