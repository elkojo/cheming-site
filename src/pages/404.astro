---
import Base from '../layouts/Base.astro';
import Bubble from '../components/Bubble.astro';
import { url } from '../lib/url';
---
<Base title="Page not found">
  <div class="nf">
    <Bubble tag="404" size="lg" />
    <div>
      <h1>This page isn’t on the drawing</h1>
      <p>The address may be old or mistyped. <a href={url()}>See all tools</a>, or open the Tools menu above.</p>
    </div>
  </div>
</Base>

<style>
  .nf { display: flex; align-items: center; gap: 1.25rem; max-width: 42rem; margin: 0 auto; padding: 4rem var(--gutter) 0; }
  h1 { margin: 0; font-size: 1.5rem; font-weight: 650; }
  p { margin: 0.375rem 0 0; color: var(--muted); }
</style>
