---
// Generates one page per tool: /pump/, /kod/, …
import Base from '../layouts/Base.astro';
import Bubble from '../components/Bubble.astro';
import Legend from '../components/Legend.astro';
import ZohoEmbed from '../components/ZohoEmbed.astro';
import NativeCalc from '../components/NativeCalc.astro';
import PrimeCalc from '../components/PrimeCalc.astro';
import GasCalc from '../components/GasCalc.astro';
import UnitCalc from '../components/UnitCalc.astro';
import SteamCalc from '../components/SteamCalc.astro';
import SieveCalc from '../components/SieveCalc.astro';
import PipeSizeCalc from '../components/PipeSizeCalc.astro';
import PropertiesCalc from '../components/PropertiesCalc.astro';
import PressureLoss1PCalc from '../components/PressureLoss1PCalc.astro';
import TwoPhaseCalc from '../components/TwoPhaseCalc.astro';
import CVCalc from '../components/CVCalc.astro';
import ROCalc from '../components/ROCalc.astro';
import DrumCalc from '../components/DrumCalc.astro';
import PumpCalc from '../components/PumpCalc.astro';
import CompressorCalc from '../components/CompressorCalc.astro';
import HeatExchangerCalc from '../components/HeatExchangerCalc.astro';
import PedCalc from '../components/PedCalc.astro';
import PsvFireCalc from '../components/PsvFireCalc.astro';
import KodCalc from '../components/KodCalc.astro';
import FlareCalc from '../components/FlareCalc.astro';
import NoiseCalc from '../components/NoiseCalc.astro';
import PsvCalc from '../components/PsvCalc.astro';
import PrsCalc from '../components/PrsCalc.astro';
import SourceList from '../components/SourceList.astro';
import { tools, categories } from '../data/tools';
import { url } from '../lib/url';

export function getStaticPaths() {
  return tools.map((tool) => ({ params: { tool: tool.slug }, props: { tool } }));
}
const { tool } = Astro.props;
const category = categories.find((c) => c.id === tool.category)!;
const siblings = tools.filter((t) => t.category === tool.category && t.slug !== tool.slug);
const openUrl = tool.zoho.replace(/([?&])mode=embed&?/, '$1').replace(/[?&]$/, '');
const description = tool.description ?? `${tool.name}. Free engineering calculator with references and equations.`;
---
<Base title={tool.name === tool.title ? tool.title : `${tool.title}: ${tool.name}`} description={description} current={tool.slug}>
  <div class="head">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={url()}>Tools</a><span aria-hidden="true">/</span><a href={url(`#cat-${category.id}`)}>{category.title}</a>
    </nav>
    <div class="title">
      <Bubble tag={tool.tag} sub={tool.sub} size="lg" />
      <div>
        <h1>{tool.name}</h1>
        {tool.standard && <p class="std">Basis: {tool.standard}</p>}
        {tool.description && <p class="desc">{tool.description}</p>}
        {tool.credit && <p class="credit">Credits: <a href={tool.credit.url} rel="noopener">{tool.credit.name}</a></p>}
      </div>
    </div>
    <div class="aside">
      <Legend compact native={!!tool.native} />
      <a class="open" href={openUrl} target="_blank" rel="noopener">
        {tool.native ? 'Original Zoho sheet' : 'Open sheet full screen'}
        <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M4.5 2H10v5.5M10 2 2.5 9.5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
        <span class="sr">(opens Zoho in a new tab)</span>
      </a>
    </div>
  </div>

  <div class="sheetwrap">
    {tool.native === 'primes' ? <PrimeCalc />
      : tool.native === 'gas' ? <GasCalc />
      : tool.native === 'units' ? <UnitCalc />
      : tool.native === 'steam' ? <SteamCalc />
      : tool.native === 'sieve' ? <SieveCalc />
      : tool.native === 'pipesize' ? <PipeSizeCalc />
      : tool.native === 'properties' ? <PropertiesCalc />
      : tool.native === 'pressure1p' ? <PressureLoss1PCalc />
      : tool.native === 'pressurenc' ? <PressureLoss1PCalc mode="noncircular" />
      : tool.native === 'twophase' ? <TwoPhaseCalc />
      : tool.native === 'cv' ? <CVCalc />
      : tool.native === 'ro' ? <ROCalc />
      : tool.native === 'drum' ? <DrumCalc />
      : tool.native === 'pump' ? <PumpCalc />
      : tool.native === 'compressor' ? <CompressorCalc />
      : tool.native === 'hx' ? <HeatExchangerCalc />
      : tool.native === 'ped' ? <PedCalc />
      : tool.native === 'psv' ? <PsvCalc />
      : tool.native === 'prs' ? <PrsCalc />
      : tool.native === 'psvl' ? <PsvFireCalc mode="liquid" />
      : tool.native === 'psvg' ? <PsvFireCalc mode="gas" />
      : tool.native === 'kod' ? <KodCalc />
      : tool.native === 'flare' ? <FlareCalc />
      : tool.native === 'noise' ? <NoiseCalc />
      : tool.native ? <NativeCalc id={tool.native} title={tool.title} />
      : <ZohoEmbed src={tool.zoho} title={tool.title} />}
  </div>

  <SourceList slug={tool.slug} zoho={openUrl} native={!!tool.native} />

  {siblings.length > 0 && (
    <section class="related" aria-labelledby="rel-h">
      <h2 id="rel-h">More in {category.title}</h2>
      <ul>
        {siblings.map((t) => (
          <li>
            <a href={url(`${t.slug}/`)}>
              <Bubble tag={t.tag} sub={t.sub} size="sm" />
              <span>{t.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem 2rem;
    align-items: end;
    padding: 1.25rem var(--gutter) 1rem;
  }
  .crumbs { grid-column: 1 / -1; display: flex; gap: 0.5rem; font-size: 0.875rem; color: var(--muted); }
  .crumbs a { color: var(--muted); }
  .title { display: flex; align-items: center; gap: 1.125rem; min-width: 0; }
  h1 { margin: 0; font-size: 1.5rem; line-height: 1.2; font-weight: 650; letter-spacing: -0.01em; }
  .title p { margin: 0.25rem 0 0; max-width: 70ch; }
  .std { font: 400 0.9375rem/1.3 var(--font-drawing); letter-spacing: 0.02em; }
  .desc, .credit { color: var(--muted); font-size: 0.9375rem; }
  .aside { display: grid; justify-items: end; gap: 0.625rem; max-width: 30rem; }
  .aside :global(.legend) { justify-content: flex-end; }
  .open {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 2.25rem;
    padding-inline: 0.875rem;
    border: 1px solid var(--line);
    color: var(--line);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 150ms ease-out, color 150ms ease-out;
  }
  .open:hover { background: var(--line); color: var(--paper); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .sheetwrap { padding-inline: var(--gutter); }

  .related { padding: 2rem var(--gutter) 0; }
  .related h2 { margin: 0 0 0.75rem; font: 400 0.875rem/1 var(--font-drawing); letter-spacing: 0.08em; text-transform: uppercase; }
  .related ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .related a { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--ink); text-decoration: none; font-size: 0.9375rem; }
  .related a:hover span { text-decoration: underline; text-underline-offset: 0.2em; }
  .related a:hover :global(.bubble) { color: var(--line); }

  @media (max-width: 56rem) {
    .head { grid-template-columns: 1fr; align-items: start; }
    .aside { justify-items: start; }
  }
  @media (max-width: 40rem) {
    .sheetwrap { padding-inline: 0; }
    .head { gap: 0.625rem; padding-bottom: 0.75rem; }
    .title { gap: 0.75rem; align-items: flex-start; }
    .title :global(.bubble.lg) { --d: 3rem; }
    h1 { font-size: 1.1875rem; }
    .aside { max-width: none; }
    .aside :global(.legend) { display: grid; grid-template-columns: 1fr 1fr; justify-content: start; }
    .aside :global(.legend > div) { flex-direction: column; align-items: flex-start; gap: 0.125rem; }
  }
</style>
